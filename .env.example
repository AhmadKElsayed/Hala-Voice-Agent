# Copy to .env.local and fill in. .env.local is read by both the agent
# (src/agent.py) and the mock backend (mock_backend/app.py).

# LiveKit Cloud project (or self-hosted server). The agent uses these to
# register as a worker; the backend uses them to mint the kiosk's room token.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI — conversation model, text-to-speech, transcript extraction and the
# classification check.
OPENAI_API_KEY=

# Speechmatics — speech-to-text.
SPEECHMATICS_API_KEY=

# Where the agent finds the backend. Defaults to the mock backend
# (config.yaml -> backend.base_url). Point it at the real backend to integrate.
# BACKEND_BASE_URL=http://localhost:8000
# Sent as "Authorization: Bearer <key>" on every backend call, if set.
# BACKEND_API_KEY=

# Optional overrides of config.yaml
# HALA_LLM_MODEL=
# HALA_TTS_PROVIDER=cartesia
# HALA_EXTRACT_MODEL=
# HALA_EXTRACT_TIMEOUT=
# HALA_DEFAULT_PRISONER_ID=PR-0001

# Mock backend only: folder holding the seven POC Excel files.
# POC_DATA_DIR=../PP POC Data
